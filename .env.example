# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Payment
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_sample
STRIPE_SECRET_KEY=sk_test_sample
STRIPE_WEBHOOK_SECRET=whsec_sample

# PayPal Payment
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb-sample-client-id
PAYPAL_CLIENT_SECRET=sample-secret

# ATH Móvil (Puerto Rico)
ATH_MOBILE_PUBLIC_KEY=sample-public-key
ATH_MOBILE_SECRET_KEY=sample-secret-key
ATH_MOBILE_BUSINESS_TOKEN=sample-token
ATH_MOBILE_PHONE=7870000000

# Resend Email Service
RESEND_API_KEY=re_sample_key
ADMIN_NOTIFICATION_EMAIL=orders@my3d.pr

# Instagram Integration
INSTAGRAM_ACCESS_TOKEN=sample-access-token

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Feature Toggles
NEXT_PUBLIC_FEATURE_BUILD_A_BOX=true
NEXT_PUBLIC_FEATURE_CUSTOM_STUDIO=true
NEXT_PUBLIC_FEATURE_REVIEWS=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_NEWSLETTER=true
