# Public site configuration
NEXT_PUBLIC_SITE_URL=[REQUIRED]
NEXT_PUBLIC_BUSINESS_EMAIL=[REQUIRED]

# Server-only admin session signing secret (minimum 32 random bytes)
ADMIN_SESSION_SECRET=[REQUIRED]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=[REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=[REQUIRED_SERVER_ONLY]

# Payment providers — the UI remains disabled until every server-only value is configured
# This release intentionally supports test payments only. Do not use live keys.
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=[REQUIRED_SERVER_ONLY_FOR_STRIPE]
STRIPE_WEBHOOK_SECRET=[REQUIRED_SERVER_ONLY_FOR_STRIPE]
PAYPAL_CLIENT_ID=[REQUIRED_SERVER_ONLY_FOR_PAYPAL]
PAYPAL_CLIENT_SECRET=[REQUIRED_SERVER_ONLY_FOR_PAYPAL]
PAYPAL_WEBHOOK_ID=[REQUIRED_SERVER_ONLY_FOR_PAYPAL]
PAYPAL_ENVIRONMENT=sandbox
PAYMENT_STATUS_SECRET=[REQUIRED_SERVER_ONLY_MIN_32_CHARS]
CRON_SECRET=[REQUIRED_SERVER_ONLY_MIN_32_CHARS]

# Transactional email
RESEND_API_KEY=[OPTIONAL_SERVER_ONLY]
ADMIN_NOTIFICATION_EMAIL=[OWNER_ACTION_REQUIRED]

# Optional integrations
INSTAGRAM_ACCESS_TOKEN=[OPTIONAL_SERVER_ONLY]
NEXT_PUBLIC_GA_MEASUREMENT_ID=[OPTIONAL]
NEXT_PUBLIC_META_PIXEL_ID=[OPTIONAL]
