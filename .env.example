# Public site configuration
NEXT_PUBLIC_SITE_URL=[REQUIRED]
NEXT_PUBLIC_BUSINESS_EMAIL=[REQUIRED]

# Server-only admin session signing secret (minimum 32 random bytes)
ADMIN_SESSION_SECRET=[REQUIRED]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=[REQUIRED]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=[REQUIRED_SERVER_ONLY]

# Optional payment providers — keep UI disabled until implemented and verified
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=[OPTIONAL]
STRIPE_SECRET_KEY=[OPTIONAL_SERVER_ONLY]
STRIPE_WEBHOOK_SECRET=[OPTIONAL_SERVER_ONLY]
NEXT_PUBLIC_PAYPAL_CLIENT_ID=[OPTIONAL]
PAYPAL_CLIENT_SECRET=[OPTIONAL_SERVER_ONLY]
ATH_MOBILE_PUBLIC_KEY=[OPTIONAL]
ATH_MOBILE_SECRET_KEY=[OPTIONAL_SERVER_ONLY]
ATH_MOBILE_BUSINESS_TOKEN=[OPTIONAL_SERVER_ONLY]
ATH_MOBILE_PHONE=[OWNER_ACTION_REQUIRED]

# Transactional email
RESEND_API_KEY=[OPTIONAL_SERVER_ONLY]
ADMIN_NOTIFICATION_EMAIL=[OWNER_ACTION_REQUIRED]

# Optional integrations
INSTAGRAM_ACCESS_TOKEN=[OPTIONAL_SERVER_ONLY]
NEXT_PUBLIC_GA_MEASUREMENT_ID=[OPTIONAL]
NEXT_PUBLIC_META_PIXEL_ID=[OPTIONAL]
